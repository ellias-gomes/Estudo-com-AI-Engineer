# ==============================================================================
# MODELO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para .env e customize os valores conforme seu ambiente.
# ==============================================================================

# Identificação e perfil do usuário
USER_NAME=Usuario
TRAINING_USER_NAME=usuario
TRAINING_USER_AGE=25

# Servidor de Inferência Local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Modelos Locais Utilizados
OLLAMA_CHAT_MODEL=deepseek-r1:8b
OLLAMA_EXTRACTOR_MODEL=qwen2.5:1.5b
OLLAMA_COMPRESSION_MODEL=deepseek-v3.1:671b-cloud

# Variáveis para possíveis integrações futuras (descomente e preencha se necessário)
# API_PROVIDER=gemini   # ou openai (usado por cliente_api.py)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# HF_TOKEN=
# SUPABASE_URL=
# SUPABASE_KEY=
